cache_directory": {"type": "string"}, "quarantine_directory": {"type": "string"}, "deletion_procedure": {"type": "string"}, "rollback_procedure": {"type": "string"}, "network_required": {"const": true}, "vram_status": {"const": "NOT_MEASURED"}, "latency_status": {"const": "NOT_MEASURED"}, "oom_status": {"const": "NOT_MEASURED"}, "quality_status": {"const": "NOT_MEASURED"}, "qualification_status": {"enum": ["QUALIFIED", "NOT_QUALIFIED", "INCONCLUSIVE"]}, "blocking_findings": {"type": "array"}}}}
