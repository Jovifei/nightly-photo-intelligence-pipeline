{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "n2b1p_runtime_configuration_v1_0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "configuration_version", "runtime_parent", "work_root", "snapshot_root", "cache_root", "cache_root_identity", "configuration_digest"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "configuration_version": {"const": "N2B1P_RUNTIME_CONFIGURATION_V1"},
    "runtime_parent": {"type": "string", "minLength": 3},
    "work_root": {"type": "string", "minLength": 3},
    "snapshot_root": {"const": "NOT_APPLICABLE_N2B1P_SOURCE_ACCESS_FORBIDDEN"},
    "cache_root": {"type": "string", "minLength": 3},
    "cache_root_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "configuration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
