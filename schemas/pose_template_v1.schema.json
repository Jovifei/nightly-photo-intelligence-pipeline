{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/pose_template_v1.schema.json",
  "title": "NPI Pose Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "coordinate_system",
    "keypoints",
    "joint_angles",
    "body_orientation",
    "mirror_strategy",
    "difficulty",
    "constraints"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_type",
        "model_id",
        "revision"
      ],
      "properties": {
        "producer_type": {
          "enum": [
            "PROFESSIONAL_POSE_MODEL",
            "DETERMINISTIC_GEOMETRY"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "weights_sha256": {
          "anyOf": [
            {
              "$ref": "common_v1.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "coordinate_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "space",
        "origin",
        "x_axis",
        "y_axis",
        "normalized",
        "image_width",
        "image_height"
      ],
      "properties": {
        "space": {
          "enum": [
            "SOURCE_IMAGE",
            "DERIVED_IMAGE"
          ]
        },
        "origin": {
          "const": "TOP_LEFT"
        },
        "x_axis": {
          "const": "RIGHT"
        },
        "y_axis": {
          "const": "DOWN"
        },
        "normalized": {
          "const": true
        },
        "image_width": {
          "type": "integer",
          "minimum": 1
        },
        "image_height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "keypoints": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "x",
          "y",
          "confidence",
          "visibility"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "$ref": "common_v1.schema.json#/$defs/confidence"
          },
          "visibility": {
            "enum": [
              "VISIBLE",
              "OCCLUDED",
              "OUT_OF_FRAME",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "joint_angles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "degrees",
          "confidence",
          "method"
        ],
        "properties": {
          "degrees": {
            "type": "number",
            "minimum": 0,
            "maximum": 360
          },
          "confidence": {
            "$ref": "common_v1.schema.json#/$defs/confidence"
          },
          "method": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "body_orientation": {
      "enum": [
        "FRONT",
        "BACK",
        "PROFILE_LEFT",
        "PROFILE_RIGHT",
        "THREE_QUARTER_LEFT",
        "THREE_QUARTER_RIGHT",
        "UNKNOWN"
      ]
    },
    "mirror_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_is_mirrored",
        "allowed_for_guidance",
        "left_right_semantics"
      ],
      "properties": {
        "source_is_mirrored": {
          "enum": [
            "YES",
            "NO",
            "UNKNOWN"
          ]
        },
        "allowed_for_guidance": {
          "type": "boolean"
        },
        "left_right_semantics": {
          "const": "SUBJECT_ANATOMICAL_LEFT_RIGHT"
        }
      }
    },
    "difficulty": {
      "enum": [
        "EASY",
        "MODERATE",
        "HARD",
        "UNKNOWN"
      ]
    },
    "constraints": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}
