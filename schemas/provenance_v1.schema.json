{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/provenance_v1.schema.json",
  "title": "NPI Provenance v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "schemas",
    "models",
    "algorithms",
    "prompts",
    "licenses",
    "effective_config_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "const": "nightly-photo-intelligence-pipeline"
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{7,40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    },
    "schemas": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "purpose",
          "model_id",
          "revision",
          "code_license",
          "weight_license",
          "weights_sha256"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "POSE",
              "SEGMENTATION",
              "VLM",
              "EMBEDDING",
              "OTHER"
            ]
          },
          "model_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "code_license": {
            "type": "string",
            "minLength": 1
          },
          "weight_license": {
            "type": "string",
            "minLength": 1
          },
          "weights_sha256": {
            "anyOf": [
              {
                "$ref": "common_v1.schema.json#/$defs/sha256"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "algorithms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prompts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "component_type",
          "license_id",
          "source"
        ],
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "component_type": {
            "enum": [
              "CODE",
              "MODEL_WEIGHTS",
              "DATA",
              "PROMPT",
              "OTHER"
            ]
          },
          "license_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "effective_config_sha256": {
      "$ref": "common_v1.schema.json#/$defs/sha256"
    }
  }
}
