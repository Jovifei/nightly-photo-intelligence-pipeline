{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/n2b1_quarantine_approval_v1_0.schema.json",
  "title": "Future N2B1-Q Owner Quarantine Approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "approval_id", "status", "owner", "owner_decision_reference",
    "issued_at", "not_before", "expires_at", "revoked", "stage", "artifact_id",
    "expected_artifact_filename", "official_request_url", "allowed_request_domains",
    "allowed_final_domains", "redirect_limit", "expected_size_bytes", "owner_max_bytes",
    "quarantine_destination_fingerprint", "code_license_status", "weights_license_status",
    "commercial_use_status", "artifact_identity_status", "immutable_revision_status",
    "official_hash_status", "ready_for_quarantine_download", "artifact_revision", "expected_sha256", "rights_snapshot_digest",
    "project_state_digest", "n2b0_5_baseline_sha"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_id": {"type": "string", "minLength": 1},
    "status": {"const": "APPROVED"},
    "owner": {"type": "string", "minLength": 1},
    "owner_decision_reference": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "not_before": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T.*(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "revoked": {"const": false},
    "stage": {"const": "N2B1_Q"},
    "artifact_id": {"type": "string", "minLength": 1},
    "expected_artifact_filename": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
    "official_request_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "allowed_request_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_final_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "redirect_limit": {"type": "integer", "minimum": 0},
    "expected_size_bytes": {"type": "integer", "minimum": 1},
    "owner_max_bytes": {"type": "integer", "minimum": 1},
    "quarantine_destination_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "code_license_status": {"const": "PASS"},
    "weights_license_status": {"const": "PASS"},
    "commercial_use_status": {"const": "PASS"},
    "artifact_identity_status": {"const": "PASS"},
    "immutable_revision_status": {"const": "PASS"},
    "official_hash_status": {"const": "PASS"},
    "ready_for_quarantine_download": {"const": "PASS"},
    "artifact_revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "source_url"],
      "properties": {
        "kind": {"enum": ["GIT_COMMIT", "GIT_TAG", "RELEASE_ASSET_VERSION", "OBJECT_VERSION", "CHECKPOINT_REVISION"]},
        "value": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "expected_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rights_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "n2b0_5_baseline_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
