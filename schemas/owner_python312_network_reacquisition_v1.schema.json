{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/owner_python312_network_reacquisition_v1.schema.json",
  "title": "Owner Python 3.12 network wheelhouse reacquisition authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_type", "status", "owner_id", "reviewed_code_commit", "task_ref", "schema_ref", "route_reason", "scope", "allowed_network", "storage", "execution_authority", "prohibitions", "mandatory_stop"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_type": {"const": "OWNER_PY312_NETWORK_REACQUISITION"},
    "status": {"const": "OWNER_AUTHORIZED_AWAITING_EXTERNAL_REVIEW"},
    "owner_id": {"const": "Jovi"},
    "reviewed_code_commit": {"const": "a2c338b2fe9467d9668566eadfe0b1fc094df526"},
    "task_ref": {"const": "tasks/tooling_python312_network_reacquisition_v1.yaml"},
    "schema_ref": {"const": "schemas/owner_python312_network_reacquisition_v1.schema.json"},
    "route_reason": {"const": "NO_QUALIFIED_LOCAL_WHEELHOUSE_FOUND_IN_BOUNDED_SEARCH"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["interpreter", "platform", "abi", "direct_pins_ref", "transitive_policy", "wheel_only", "source_distributions"],
      "properties": {
        "interpreter": {"const": "CPython >=3.12,<3.13"},
        "platform": {"const": "win_amd64"},
        "abi": {"const": "cp312"},
        "direct_pins_ref": {"const": "tasks/tooling_python312_quality_environment_execution_v1.yaml#packages.direct_pins"},
        "transitive_policy": {"const": "ONLY_DEPENDENCIES_REQUIRED_BY_THE_NINE_DIRECT_PINS"},
        "wheel_only": {"const": true},
        "source_distributions": {"const": false}
      }
    },
    "allowed_network": {
      "type": "object", "additionalProperties": false,
      "required": ["scheme", "domains", "redirect_policy", "authentication", "proxy_or_custom_index", "git_or_source_repository"],
      "properties": {
        "scheme": {"const": "HTTPS"},
        "domains": {"const": ["pypi.org", "files.pythonhosted.org"]},
        "redirect_policy": {"const": "FINAL_DOMAIN_MUST_BE_IN_ALLOWED_DOMAINS"},
        "authentication": {"const": "NONE"},
        "proxy_or_custom_index": {"const": "FORBIDDEN"},
        "git_or_source_repository": {"const": "FORBIDDEN"}
      }
    },
    "storage": {
      "type": "object", "additionalProperties": false,
      "required": ["download_root_ref", "quarantine_root_ref", "wheelhouse_root_ref", "manifest_ref", "git_tracking", "source_overlap", "reparse_points", "quarantine_cleanup", "download_root_object_identity_sha256", "download_root_path_attestation_ref", "download_root_non_reparse", "download_root_outside_git", "download_root_overlap_check"],
      "properties": {
        "download_root_ref": {"const": "E_CLAUDE_ALLOW_DOWNLOAD"},
        "quarantine_root_ref": {"const": "E_CLAUDE_ALLOW_DOWNLOAD/npi-py312-tooling-quarantine-20260928"},
        "wheelhouse_root_ref": {"const": "E_CLAUDE_ALLOW_DOWNLOAD/npi-py312-tooling-wheelhouse-20260928"},
        "manifest_ref": {"const": "E_CLAUDE_ALLOW_DOWNLOAD/npi-py312-tooling-wheelhouse-20260928/manifest.json"},
        "git_tracking": {"const": "FORBIDDEN"},
        "source_overlap": {"const": "FORBIDDEN"},
        "reparse_points": {"const": "FORBIDDEN"},
        "quarantine_cleanup": {"const": "FORBIDDEN_UNTIL_REVIEW_CLOSURE"}
        ,"download_root_object_identity_sha256": {"const": "OWNER_TO_PROVIDE_DOWNLOAD_ROOT_OBJECT_IDENTITY_SHA256"}
        ,"download_root_path_attestation_ref": {"const": "OWNER_TO_PROVIDE_DOWNLOAD_ROOT_PATH_ATTESTATION"}
        ,"download_root_non_reparse": {"const": true}
        ,"download_root_outside_git": {"const": true}
        ,"download_root_overlap_check": {"const": "REQUIRED"}
      }
    },
    "execution_authority": {
      "type": "object", "additionalProperties": false,
      "required": ["owner_authorized", "external_exact_sha_review_required", "network_download_before_review", "installation_before_review"],
      "properties": {
        "owner_authorized": {"const": true},
        "external_exact_sha_review_required": {"const": true},
        "network_download_before_review": {"const": false},
        "installation_before_review": {"const": false}
      }
    },
    "execution_controls": {
      "type": "object", "additionalProperties": false,
      "required": ["package_install_during_network", "venv_creation_during_network", "model_or_cuda_install", "wheelhouse_promotion_before_manifest_review", "quarantine_retention"],
      "properties": {
        "package_install_during_network": {"const": false},
        "venv_creation_during_network": {"const": false},
        "model_or_cuda_install": {"const": false},
        "wheelhouse_promotion_before_manifest_review": {"const": false},
        "quarantine_retention": {"const": true}
      }
    },
    "wheelhouse_evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_ref", "status_after_network", "required_fields"],
      "properties": {
        "schema_ref": {"const": "schemas/python312_wheelhouse_evidence_v1.schema.json"},
        "status_after_network": {"const": "PY312_WHEELHOUSE_QUALIFIED_AWAITING_EXTERNAL_REVIEW"},
        "required_fields": {"const": ["manifest_sha256", "wheelhouse_object_identity_sha256", "resolved_packages", "download_root_attestation"]}
      }
    },
    "prohibitions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mandatory_stop": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "next_action"],
      "properties": {"value": {"const": true}, "next_action": {"const": "PY312_WHEELHOUSE_QUALIFIED_AWAITING_EXTERNAL_REVIEW"}}
    }
  }
}
