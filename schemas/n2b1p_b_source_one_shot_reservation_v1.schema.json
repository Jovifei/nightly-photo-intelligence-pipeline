{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/n2b1p_b_source_one_shot_reservation_v1.schema.json",
  "title": "B-source one-shot lease reservation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_type", "state", "reviewed_head", "reviewed_tree", "lease_identity_sha256", "reservation_file_identity_sha256", "nonce", "claimed_at_utc", "retry_authorized"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "evidence_type": {"const": "B_SOURCE_NETWORK_ONE_SHOT_RESERVATION_V1"},
    "state": {"const": "CLAIMED"},
    "reviewed_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reviewed_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "lease_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reservation_file_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claimed_at_utc": {"type": "string", "format": "date-time"},
    "retry_authorized": {"const": false}
  }
}
