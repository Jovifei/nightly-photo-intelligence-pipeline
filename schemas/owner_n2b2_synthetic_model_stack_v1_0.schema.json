{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/owner_n2b2_synthetic_model_stack_v1_0.schema.json",
  "title": "Owner bounded N2B2 synthetic model-stack authorization",
