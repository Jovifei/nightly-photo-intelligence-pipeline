{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/n2b2_runtime_execution_lease_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_type", "status", "owner_id", "issued_at_utc", "task", "receipt_id", "external_review_sha256", "accepted_verdict", "accepted_blocker", "old_identity", "authorized_identity", "source_candidate", "source_git_tree", "source_tree_sha256", "source_tree_file_count", "project_state_sha256", "project_state_n2b2", "production_unlock", "boundaries", "max_fresh_s3_runs", "max_fresh_s20_runs", "mandatory_external_review"],
  "properties": {
    "schema_version": {"const": "n2b2-runtime-execution-lease-v1"},
    "receipt_type": {"const": "OWNER_N2B2_SYNTHETIC_RUNTIME_EXECUTION_LEASE"},
    "status": {"const": "APPROVED"},
    "owner_id": {"const": "Jovi"},
    "issued_at_utc": {"type": "string", "format": "date-time"},
    "task": {"type": "string", "pattern": "^N2B2_SYNTHETIC_RUNTIME_REMEDIATION_[0-9]{8}$"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "external_review_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "accepted_verdict": {"const": "INCONCLUSIVE"},
    "accepted_blocker": {"const": "N2B2_S20_RESUME_BINDING_MISMATCH: model_identity"},
    "old_identity": {"$ref": "#/$defs/identity"},
    "authorized_identity": {"$ref": "#/$defs/identity"},
    "source_candidate": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_git_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_tree_file_count": {"type": "integer", "minimum": 1},
    "project_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_state_n2b2": {"const": "LOCKED"},
    "production_unlock": {"const": false},
    "boundaries": {"$ref": "#/$defs/closedBoundaries"},
    "max_fresh_s3_runs": {"const": 1},
    "max_fresh_s20_runs": {"const": 1},
    "mandatory_external_review": {"const": true}
  },
  "$defs": {
    "closedBoundaries": {"type": "object", "additionalProperties": false, "required": ["real_photo", "real_exif", "g1_source", "sqlite", "real20", "app", "production_bundle", "model_download", "model_replacement"], "properties": {"real_photo": {"const": false}, "real_exif": {"const": false}, "g1_source": {"const": false}, "sqlite": {"const": false}, "real20": {"const": false}, "app": {"const": false}, "production_bundle": {"const": false}, "model_download": {"const": false}, "model_replacement": {"const": false}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["model_name", "full_local_digest", "size_bytes", "quantization_level", "capabilities", "ollama_version", "canonical_identity_sha256"], "properties": {"model_name": {"const": "qwen3.5:9b"}, "full_local_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1}, "quantization_level": {"const": "Q4_K_M"}, "capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "ollama_version": {"type": "string", "minLength": 1}, "canonical_identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
