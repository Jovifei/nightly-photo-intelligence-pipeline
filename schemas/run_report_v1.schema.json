{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/run_report_v1.schema.json",
  "title": "NPI Run Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "profile",
    "started_at",
    "finished_at",
    "authorization",
    "counts",
    "quality",
    "resources",
    "versions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "fixture",
        "calibration",
        "pilot",
        "nightly"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "data_gate",
        "manifest_sha256"
      ],
      "properties": {
        "phase": {
          "type": "string"
        },
        "data_gate": {
          "type": "string"
        },
        "manifest_sha256": {
          "anyOf": [
            {
              "$ref": "common_v1.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_pass_rate",
        "source_integrity_failures"
      ],
      "properties": {
        "schema_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_integrity_failures": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "average_seconds_per_asset",
        "peak_gpu_vram_mb"
      ],
      "properties": {
        "average_seconds_per_asset": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "peak_gpu_vram_mb": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
