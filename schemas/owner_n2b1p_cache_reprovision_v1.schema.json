{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/owner_n2b1p_cache_reprovision_v1.schema.json",
  "title": "Owner draft approval for N2B1P cache re-provision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "approval_type", "status", "owner_id", "scope", "contract_ref", "execution_authority", "prohibited_actions", "mandatory_stop"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "approval_type": {"const": "OWNER_N2B1P_CACHE_REPROVISION"},
    "status": {"const": "DRAFT_NOT_AUTHORIZED"},
    "owner_id": {"const": "Jovi"},
    "scope": {"const": "VERSIONED_CONTROL_PLANE_ONLY"},
    "contract_ref": {"const": "tasks/phase_n2b1p_cache_reprovision_v1.yaml"},
    "execution_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["b_cache", "b_source", "network"],
      "properties": {
        "b_cache": {"const": "NOT_AUTHORIZED"},
        "b_source": {"const": "NOT_AUTHORIZED"},
        "network": {"const": "DENY"}
      }
    },
    "prohibited_actions": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "mandatory_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "next_action"],
      "properties": {"value": {"const": true}, "next_action": {"const": "EXTERNAL_REVIEW_ROUTE_B_CONTROL_PLANE"}}
    }
  }
}
