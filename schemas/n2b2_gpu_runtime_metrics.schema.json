{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/n2b2_gpu_runtime_metrics.schema.json",
  "title": "N2B2 GPU runtime metrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_count", "devices", "formal_cuda_gate"],
  "properties": {
    "schema_version": {"const": "n2b2-gpu-runtime-metrics-v1"},
    "status": {"type": "string", "minLength": 1},
    "stop_reason": {"type": "string", "minLength": 1},
    "fixture_count": {"const": 3},
    "devices": {
      "type": "object",
      "properties": {
        "cpu": {"$ref": "#/$defs/device"},
        "cuda": {"$ref": "#/$defs/device"}
      },
      "additionalProperties": false,
      "anyOf": [
        {"required": ["cpu", "cuda"]},
        {"maxProperties": 0}
      ]
    },
    "formal_cuda_gate": {"type": "boolean"},
    "runtime": {"type": "object", "additionalProperties": true},
    "hard_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_photo_read_count", "real_exif_read_count", "g1_source_access",
        "sqlite_write_count", "app_write_count", "obsidian_write_count"
      ],
      "properties": {
        "real_photo_read_count": {"const": 0},
        "real_exif_read_count": {"const": 0},
        "g1_source_access": {"const": 0},
        "sqlite_write_count": {"const": 0},
        "app_write_count": {"const": 0},
        "obsidian_write_count": {"const": 0}
      }
    }
  },
  "$defs": {
    "device": {
      "type": "object",
      "required": ["requested_device", "status", "facts", "schema_errors", "metrics"],
      "properties": {
        "requested_device": {"enum": ["cpu", "cuda"]},
        "status": {"type": "string"},
        "facts": {"type": "array"},
        "schema_errors": {"type": "array", "items": {"type": "string"}},
        "stop_reason": {"type": ["string", "null"]},
        "runtime_attestation": {"type": "object", "additionalProperties": true},
        "metrics": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": false
    }
  }
}
