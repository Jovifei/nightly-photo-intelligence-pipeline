{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_type", "source_fingerprint", "assets"],
  "properties": {
    "schema_version": {"const": "npi-real20-manifest-v2"},
    "source_type": {"const": "OWNER_FROZEN_REAL_PHOTO_SNAPSHOT"},
    "source_fingerprint": {"type": "string", "minLength": 8, "maxLength": 256},
    "assets": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "relative_path", "sha256"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "duplicate_of": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"}
        }
      }
    }
  }
}
