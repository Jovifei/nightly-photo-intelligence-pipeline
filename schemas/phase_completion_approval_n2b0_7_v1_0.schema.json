      "properties": {
        "n2b0_6_commit": {"const": "eb2eaeb61f1c21923d131a115d63edbcdebd8cb2"},
        "n2b0_6_tag": {"const": "n2b0-6-approved-2026-07-29"},
        "n2b0_7_commit": {"const": "f2b1c38301d71da52b855f73de8a67908cb525ef"},
