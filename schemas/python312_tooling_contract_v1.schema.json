{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/python312_tooling_contract_v1.schema.json",
  "title": "Python 3.12 quality tooling control-plane draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "phase", "capability", "interpreter", "packages", "source_policy", "prohibited_actions", "mandatory_stop"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": {"const": "PY312_TOOLING"},
        "title": {"const": "Supported Python 3.12 quality tooling control plane"},
        "status": {"const": "DRAFT_NOT_AUTHORIZED"}
      }
    },
    "capability": {"const": "PY312_QUALITY_TOOLING_CONTROL_PLANE"},
    "interpreter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python_constraint", "executable_ref", "venv_root_ref"],
      "properties": {
        "python_constraint": {"const": ">=3.12,<3.13"},
        "executable_ref": {"const": "OWNER_TO_PROVIDE_PYTHON312_EXECUTABLE"},
        "venv_root_ref": {"const": "OWNER_TO_PROVIDE_GIT_EXTERNAL_VENV"}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {"const": {"name": "typer", "version": "0.26.8", "purpose": "runtime"}},
          {"const": {"name": "pydantic", "version": "2.13.4", "purpose": "runtime"}},
          {"const": {"name": "pyyaml", "version": "6.0.3", "purpose": "runtime"}},
          {"const": {"name": "pillow", "version": "12.3.0", "purpose": "runtime"}},
          {"const": {"name": "pytest", "version": "9.1.1", "purpose": "dev"}},
          {"const": {"name": "ruff", "version": "0.15.21", "purpose": "dev"}},
          {"const": {"name": "mypy", "version": "2.3.0", "purpose": "dev"}},
          {"const": {"name": "jsonschema", "version": "4.26.0", "purpose": "dev"}},
          {"const": {"name": "referencing", "version": "0.37.0", "purpose": "dev"}}
        ]
      }
    },
    "source_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preferred", "network", "model_packages"],
      "properties": {
        "preferred": {"const": "OWNER_APPROVED_LOCAL_WHEELHOUSE_NO_INDEX"},
        "network": {"const": "SEPARATE_TOOLING_APPROVAL_REQUIRED"},
        "model_packages": {"const": "FORBIDDEN"}
      }
    },
    "prohibited_actions": {
      "type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1},
      "allOf": [
        {"contains": {"const": "model_weight_download"}},
        {"contains": {"const": "torch_or_cuda_install"}},
        {"contains": {"const": "network_package_retrieval"}},
        {"contains": {"const": "system_python_mutation"}},
        {"contains": {"const": "driver_or_cuda_configuration"}},
        {"contains": {"const": "photo_exif_sqlite_access"}},
        {"contains": {"const": "real20_lease_or_reservation"}},
        {"contains": {"const": "app_or_bundle_write"}}
      ]
    },
    "mandatory_stop": {
      "type": "object", "additionalProperties": false, "required": ["value", "next_action"],
      "properties": {"value": {"const": true}, "next_action": {"const": "EXTERNAL_REVIEW_PY312_TOOLING_CONTROL_PLANE"}}
    }
  }
}
