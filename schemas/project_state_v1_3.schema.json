{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/project_state_v1_3.schema.json",
  "title": "NPI future N2B1 capability-gated project state v1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "project", "baselines", "n2b0_5_baseline_sha", "authorization",
    "data_scope", "phase_status", "required_stop_after"
  ],
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tag", "status", "immutable"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tag": {"type": "string", "minLength": 1},
        "status": {"const": "APPROVED_COMPLETE"},
        "immutable": {"const": true}
      }
    },
    "stage": {"enum": ["LOCKED", "AUTHORIZED", "APPROVED_COMPLETE"]}
  },
  "properties": {
    "schema_version": {"const": "1.3"},
    "project": {
      "type": "object", "additionalProperties": false,
      "required": ["slug", "repository_relationship"],
      "properties": {
        "slug": {"const": "nightly-photo-intelligence-pipeline"},
        "repository_relationship": {"const": "INDEPENDENT_FROM_ai-photography-director-app"}
      }
    },
    "baselines": {
      "type": "object", "additionalProperties": false,
      "required": ["N0", "N1", "G1", "N2A", "N2B0", "N2B0_5"],
      "properties": {
        "N0": {"$ref": "#/$defs/baseline"}, "N1": {"$ref": "#/$defs/baseline"},
        "G1": {"$ref": "#/$defs/baseline"}, "N2A": {"$ref": "#/$defs/baseline"},
        "N2B0": {"$ref": "#/$defs/baseline"}, "N2B0_5": {"$ref": "#/$defs/baseline"}
      }
    },
    "n2b0_5_baseline_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "data_gate", "capability_gates", "large_model_downloads", "real_model_execution"],
      "properties": {
        "phase": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "status"],
          "properties": {"id": {"const": "N1"}, "status": {"const": "APPROVED_COMPLETE"}}
        },
        "data_gate": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "status"],
          "properties": {"id": {"const": "G1_CALIBRATION_20"}, "status": {"const": "AUTHORIZED"}}
        },
        "capability_gates": {
          "type": "object", "additionalProperties": false,
          "required": [
            "G1_COMPLETION", "N2A_POSE_SEGMENTATION_BENCHMARK_PREPARATION",
            "N2B0_MODEL_ARTIFACT_QUALIFICATION", "N2B0_5_ARTIFACT_RIGHTS_AND_PROVENANCE_CLOSURE",
            "N2B_MODEL_DOWNLOAD_AND_INFERENCE", "N2B1_MODEL_DOWNLOAD",
            "N2B1_Q_QUARANTINE_DOWNLOAD", "N2B1_P_CACHE_PROMOTION", "N2B2_REAL_BENCHMARK"
          ],
          "properties": {
            "G1_COMPLETION": {"const": "APPROVED_COMPLETE"},
            "N2A_POSE_SEGMENTATION_BENCHMARK_PREPARATION": {"const": "APPROVED_COMPLETE"},
            "N2B0_MODEL_ARTIFACT_QUALIFICATION": {"const": "APPROVED_COMPLETE"},
            "N2B0_5_ARTIFACT_RIGHTS_AND_PROVENANCE_CLOSURE": {"const": "APPROVED_COMPLETE"},
            "N2B_MODEL_DOWNLOAD_AND_INFERENCE": {"$ref": "#/$defs/stage"},
            "N2B1_MODEL_DOWNLOAD": {"$ref": "#/$defs/stage"},
            "N2B1_Q_QUARANTINE_DOWNLOAD": {"$ref": "#/$defs/stage"},
            "N2B1_P_CACHE_PROMOTION": {"$ref": "#/$defs/stage"},
            "N2B2_REAL_BENCHMARK": {"$ref": "#/$defs/stage"}
          }
        },
        "large_model_downloads": {"enum": ["NOT_AUTHORIZED", "AUTHORIZED"]},
        "real_model_execution": {"const": "NOT_AUTHORIZED"}
      }
    },
    "data_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["max_assets", "allowed_assets", "G1_CALIBRATION_20", "N2B1_Q_QUARANTINE_DOWNLOAD", "N2B1_P_CACHE_PROMOTION", "N2B2_REAL_BENCHMARK", "G2_PILOT_100", "G3_FULL_LIBRARY"],
      "properties": {
        "max_assets": {"const": 20}, "allowed_assets": {"const": "owner-frozen manifest entries only"},
        "G1_CALIBRATION_20": {"const": "AUTHORIZED"},
        "N2B1_Q_QUARANTINE_DOWNLOAD": {"$ref": "#/$defs/stage"},
        "N2B1_P_CACHE_PROMOTION": {"$ref": "#/$defs/stage"},
        "N2B2_REAL_BENCHMARK": {"$ref": "#/$defs/stage"},
        "G2_PILOT_100": {"const": "LOCKED"}, "G3_FULL_LIBRARY": {"const": "LOCKED"}
      }
    },
    "phase_status": {
      "type": "object", "additionalProperties": false,
      "required": ["N0", "N1", "G1", "N2", "N2A", "N2B0", "N2B0_5", "N2B", "N2B1", "N2B1_Q", "N2B1_P", "N2B2", "N3", "N4", "N5", "N6", "N7", "N8"],
      "properties": {
        "N0": {"const": "APPROVED_COMPLETE"}, "N1": {"const": "APPROVED_COMPLETE"},
        "G1": {"const": "APPROVED_COMPLETE"}, "N2": {"$ref": "#/$defs/stage"},
        "N2A": {"const": "APPROVED_COMPLETE"}, "N2B0": {"const": "APPROVED_COMPLETE"},
        "N2B0_5": {"const": "APPROVED_COMPLETE"}, "N2B": {"$ref": "#/$defs/stage"},
        "N2B1": {"$ref": "#/$defs/stage"}, "N2B1_Q": {"$ref": "#/$defs/stage"},
        "N2B1_P": {"$ref": "#/$defs/stage"}, "N2B2": {"$ref": "#/$defs/stage"},
        "N3": {"const": "LOCKED"}, "N4": {"const": "LOCKED"}, "N5": {"const": "LOCKED"},
        "N6": {"const": "LOCKED"}, "N7": {"const": "LOCKED"}, "N8": {"const": "LOCKED"}
      }
    },
    "required_stop_after": {
      "type": "object", "additionalProperties": false,
      "required": ["condition", "next_action"],
      "properties": {
        "condition": {"enum": ["N2B0_5_AWAITING_OWNER_APPROVAL", "N2B1_Q_AWAITING_OWNER_APPROVAL"]},
        "next_action": {"const": "WAIT_FOR_OWNER_APPROVAL"}
      }
    }
  }
}
