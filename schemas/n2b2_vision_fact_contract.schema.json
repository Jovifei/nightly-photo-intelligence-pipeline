{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/n2b2_vision_fact_contract.schema.json",
  "title": "N2B2 authoritative deterministic vision fact contract",
  "description": "Canonical facts produced by deterministic models (Keypoint R-CNN, LRASPP, DeepLabV3). Qwen must not generate, modify, or override any of these fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "image_sha256",
    "provenance",
    "person_count",
    "person_boxes",
    "pose_keypoints",
    "pose_scores",
    "segmentation_person_ratio",
    "segmentation_comparator_person_ratio",
    "subject_centroids",
    "frame_contact_flags",
    "negative_space_metrics",
    "fact_ids",
    "uncertainties",
    "fact_digest"
  ],
  "properties": {
    "schema_version": {"const": "1.1"},
    "case_id": {"type": "string", "pattern": "^n2b2-s(3|20)-[0-9]{2}$"},
    "image_sha256": {"$ref": "#/$defs/sha256"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["pose_model", "segmentation_model", "comparator_model", "generator_version", "seed"], "properties": {"pose_model": {"const": "torchvision-keypointrcnn-resnet50-fpn-coco-v1"}, "segmentation_model": {"const": "torchvision-lraspp-mobilenet-v3-large-coco-voc-v1"}, "comparator_model": {"const": "torchvision-deeplabv3-mobilenet-v3-large-coco-voc-v1"}, "generator_version": {"type": "string"}, "seed": {"type": ["integer", "null"]}}},
    "person_count": {"type": "integer", "minimum": 0},
    "person_boxes": {"type": "array", "items": {"$ref": "#/$defs/bbox"}},
    "pose_keypoints": {"type": "array", "items": {"$ref": "#/$defs/keypoints"}},
    "pose_scores": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "segmentation_person_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "segmentation_comparator_person_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "subject_centroids": {"type": "array", "items": {"$ref": "#/$defs/point2d"}},
    "frame_contact_flags": {"type": "object", "additionalProperties": false, "required": ["top", "bottom", "left", "right"], "properties": {"top": {"type": "boolean"}, "bottom": {"type": "boolean"}, "left": {"type": "boolean"}, "right": {"type": "boolean"}}},
    "negative_space_metrics": {"type": "object", "additionalProperties": false, "required": ["left_ratio", "right_ratio", "top_ratio", "bottom_ratio", "total_negative_ratio"], "properties": {"left_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "right_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "top_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "bottom_ratio": {"type": "number", "minimum": 0, "maximum": 1}, "total_negative_ratio": {"type": "number", "minimum": 0, "maximum": 1}}},
    "fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"}, "uniqueItems": true},
    "uncertainties": {"type": "array", "items": {"$ref": "#/$defs/uncertainty"}},
    "fact_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bbox": {"type": "object", "additionalProperties": false, "required": ["x_min", "y_min", "x_max", "y_max"], "properties": {"x_min": {"type": "number"}, "y_min": {"type": "number"}, "x_max": {"type": "number"}, "y_max": {"type": "number"}}},
    "point2d": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
    "keypoints": {"type": "array", "minItems": 17, "maxItems": 17, "items": {"type": "object", "additionalProperties": false, "required": ["x", "y", "score"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "score": {"type": "number", "minimum": 0, "maximum": 1}}}},
    "uncertainty": {"type": "object", "additionalProperties": false, "required": ["fact_id", "description", "severity"], "properties": {"fact_id": {"type": "string", "pattern": "^fact-[a-z0-9-]+$"}, "description": {"type": "string", "minLength": 1}, "severity": {"enum": ["low", "medium", "high"]}}}
  }
}
