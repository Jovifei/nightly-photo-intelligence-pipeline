{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.npi.local/common_v1.schema.json",
  "title": "NPI Common Definitions v1",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "asset_id": {
      "type": "string",
      "pattern": "^npi_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:[A-Za-z]:[\\\\/]|/|\\\\\\\\)"
          }
        },
        {
          "not": {
            "pattern": "(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)"
          }
        }
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?(?:[-+][A-Za-z0-9._-]+)?$"
    },
    "iso_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_ref": {
      "type": "string",
      "pattern": "^(fact|pose|segment|det|review):[A-Za-z0-9._:-]+$"
    }
  }
}
